{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyprogression-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // Workers Logs (Cloudflare dashboard). The Worker never logs keys or response bodies.
  "observability": { "enabled": true },
  // Profile relay on a fixed-IP server (see the mod repository, deploy/relay). Empty: the Worker calls Hypixel itself.
  "vars": { "RELAY_URL": "https://relay.skyprogression.dev" },
  // Every three minutes: one cron step refreshes one Hypixel resource and up to 40 Coflnet quotes.
  "triggers": { "crons": ["*/3 * * * *"] },
  // Wrangler creates the namespace on the first deploy and remembers it; no ID needs to be committed.
  "kv_namespaces": [{ "binding": "PRICES" }],
  // namespace_id values are local identifiers chosen here, not account IDs. Limits apply per Cloudflare location.
  "ratelimits": [
    { "name": "IP_LIMIT", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } },
    { "name": "PLAYER_LIMIT", "namespace_id": "1002", "simple": { "limit": 4, "period": 60 } },
    { "name": "HYPIXEL_LIMIT", "namespace_id": "1003", "simple": { "limit": 100, "period": 60 } },
    // Website player lookups (POST /checklist) per IP, on top of IP_LIMIT.
    { "name": "CHECKLIST_LIMIT", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
  ]
}
